# Public values only: where on this site the analytics tracker loads from, and the site id, which
# every page shows anyway. Never a key, and never the address of a server: the web server in front
# passes the tracker's two paths on. Until both are set, no page loads a tracker.
UMAMI_PATH=/insights
UMAMI_SITE_ID=f6e00140-bba7-4ca9-800c-8728df4d0ec0
